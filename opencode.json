{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "quicknews": {
      "type": "local",
      "command": ["go", "run", ".", "--config", "./config.example.toml", "--log", "/tmp/quicknews-mcp.log", "mcp"],
      "enabled": true
    }
  },
  "formatter": {
    "gofmt": {
      "disabled": false
    }
  },
  "permission": {
    "read": {
      ".env": "deny",
      ".envrc": "deny",
      "quicknews.log": "deny",
      "quicknews": "deny"
    },
    "bash": {
      "git push": "ask",
      "git push *": "ask"
    }
  }
}
